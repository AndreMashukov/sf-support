DATABASE_URL=postgresql+psycopg://support:support@127.0.0.1:5433/support

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# Path to a Firebase service account JSON, or leave empty to use ADC
GOOGLE_APPLICATION_CREDENTIALS=
# Local Auth emulator (leave empty in production).
# Uvicorn on the host:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# API in Docker talking to host emulators:
# FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099
# Browser always uses the host loopback URL:
# FIREBASE_WEB_AUTH_EMULATOR_URL=http://127.0.0.1:9099

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Host ingest: python -m app.ingest
# Compose API seeds on startup when this is true (default false for local uvicorn).
SEED_ON_STARTUP=false
# Local Eventarc stand-in (Firebase emulator):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# LOCAL_CDC_SHORTCUT=true
TOGETHER_AI_API_KEY=your-together-api-key
TOGETHER_CHAT_MODEL=zai-org/GLM-5.2

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=study-forge-support

# StudyForge web app (Back to StudyForge link). Local:
STUDYFORGE_WEB_URL=http://localhost:4200

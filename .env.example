DATABASE_URL=postgresql+psycopg://support:support@127.0.0.1:5433/support

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-web-api-key
# Path to a Firebase service account JSON, or leave empty to use ADC
GOOGLE_APPLICATION_CREDENTIALS=

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_EMBEDDING_MODEL=intfloat/multilingual-e5-large
TOGETHER_AI_API_KEY=your-together-api-key
TOGETHER_CHAT_MODEL=zai-org/GLM-5.2

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=study-forge-support

# StudyForge web app (Back to StudyForge link). Local:
STUDYFORGE_WEB_URL=http://localhost:4200
